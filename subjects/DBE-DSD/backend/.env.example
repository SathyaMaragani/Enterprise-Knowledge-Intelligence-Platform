# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Required ---
# Base64, >= 32 bytes. Generate one:
#   openssl rand -base64 48
JWT_SECRET=

# --- Optional (defaults in application.yml target local docker) ---
JWT_EXPIRATION=86400000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=eip_db
DB_USERNAME=eip_dev
DB_PASSWORD=

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=eip_doc_db
MONGO_USERNAME=eip_mongo_user
MONGO_PASSWORD=

QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=knowledge_chunks
QDRANT_VECTOR_DIMENSION=384
