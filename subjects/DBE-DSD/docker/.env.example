# Copy to .env (git-ignored) and replace every value. Nothing here has a usable
# default on purpose: compose refuses to start while a secret is missing.

# Base64, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Database passwords. Use URL-safe characters (the MongoDB password is placed in
# a connection URI). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
MONGO_PASSWORD=

# First administrator, created on first start only (12-72 character password).
# Once an administrator exists these are ignored; clear the password afterwards.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Semantic search. Needs the MiniLM model at MODEL_DIR (onnx/model.onnx and
# tokenizer.json); set to false to run keyword search only.
EMBEDDING_ENABLED=true
# MODEL_DIR=../../../models/minilm

# Memory cap for the backend container (heap is 75% of it).
BACKEND_MEMORY=1g

# Host port for the web app.
HTTP_PORT=8088
