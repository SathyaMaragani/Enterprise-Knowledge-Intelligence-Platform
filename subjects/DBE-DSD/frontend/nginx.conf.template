# Rendered by the nginx image at startup: ${BACKEND_URL} comes from the environment.
server {
    listen 80;
    root /usr/share/nginx/html;

    # Uploads are capped at 1 MB by the backend; leave room for the multipart envelope.
    client_max_body_size 2m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Vite puts content-hashed files here, so they never change under the same name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Client-side routes (/repository, /documents/12, ...) all load the app shell.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
